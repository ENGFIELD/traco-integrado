rules_version = '2';

// Regras de segurança do Firestore para o "Traço Integrado".
// Cópia EXATA das regras publicadas em 23/09/2026 (trazidas para o
// repositório em 07/10/2026 para versionamento e testes no emulador).
// A evolução por perfil de acesso (Admin/Engenheiro/Técnico/...) está
// planejada para a Fase 2 — ver docs/DIAGNOSTICO.md, seção 3.
//
// Regra geral: só quem faz login (e-mail/senha, criado manualmente no Firebase
// Authentication) pode ler ou escrever qualquer dado.

service cloud.firestore {
  match /databases/{database}/documents {

    // v1.9: contas só de visualização (leem tudo, não gravam nada). Enquanto
    // os papéis da v2 (firestore.v2.rules) não entram em produção, a lista
    // fica aqui. Para liberar edição, tire o e-mail da lista e publique.
    function somenteLeitura() {
      return request.auth.token.get('email', '').lower() in ['jessica.araujo@sig.eng.br'];
    }
    function podeEditar() {
      return request.auth != null && !somenteLeitura();
    }

    // Fichas FVS
    match /fvs/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Controles de rastreabilidade de concreto (FORM-15)
    match /rastreabilidade/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Resultados de ensaio dos corpos de prova (Controle Tecnológico do Concreto)
    match /controleTecnologico/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Biblioteca de plantas de forma
    match /plantas/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Programação e recebimento de aço (v1.5)
    match /entregasAco/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Cronograma da obra: versão atual + histórico de versões enviadas (v1.5)
    match /cronogramas/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Cópia da última planilha importada, usada como modelo de exportação (v1.8)
    match /planilhasModelo/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Bloqueia qualquer outra coleção não prevista acima por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
