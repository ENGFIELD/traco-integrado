rules_version = '2';

// Regras de segurança do Firestore para o "Traço Integrado".
// Cópia EXATA das regras publicadas em 23/09/2026 (trazidas para o
// repositório em 07/10/2026 para versionamento e testes no emulador).
// A evolução por perfil de acesso (Admin/Engenheiro/Técnico/...) está
// planejada para a Fase 2 — ver docs/DIAGNOSTICO.md, seção 3.
//
// Regra geral: só quem faz login (e-mail/senha, criado manualmente no Firebase
// Authentication) pode ler ou escrever qualquer dado.

service cloud.firestore {
  match /databases/{database}/documents {

    // v1.31: cadastro da equipe no banco (equipe/{e-mail}, tela Equipe do app).
    // Quem NÃO está no cadastro continua como antes (edita). O cadastro serve
    // para deixar alguém só visualizando (perfil "qualidade") ou desativar.
    function emailUsuario() {
      return request.auth.token.get('email', '').lower();
    }
    function caminhoEquipe() {
      return /databases/$(database)/documents/equipe/$(emailUsuario());
    }
    function cadastrado() {
      return exists(caminhoEquipe());
    }
    function cadastro() {
      return get(caminhoEquipe()).data;
    }
    // v1.9: contas só de visualização. Sem cadastro, vale a lista antiga
    // (Jessica); com cadastro, vale o perfil/ativo de lá.
    function somenteLeitura() {
      return emailUsuario() != 'matheus.alves@sig.eng.br' && (
        (cadastrado() && (cadastro().get('perfil', '') == 'qualidade' || cadastro().get('ativo', true) == false))
        || (!cadastrado() && emailUsuario() in ['jessica.araujo@sig.eng.br']));
    }
    // administrador: o Matheus sempre (para nunca ficar trancado para fora)
    // e quem tiver perfil admin ativo no cadastro
    function ehAdmin() {
      return request.auth != null && (emailUsuario() == 'matheus.alves@sig.eng.br'
        || (cadastrado() && cadastro().get('perfil', '') == 'admin' && cadastro().get('ativo', true) != false));
    }
    function podeEditar() {
      return request.auth != null && !somenteLeitura();
    }

    // v1.15: ficha assinada pela engenharia fica travada (travada:true).
    function fichaTravada() {
      return resource.data.get('travada', false) == true;
    }

    // v1.19: na ficha travada ainda pode (a) dar baixa / incluir não
    // conformidades e (b) ACRESCENTAR a assinatura do estagiário/técnico
    // (a lista de assinaturas só cresce: ninguém tira a da engenharia).
    function baixaOuAssinaturaNaTravada() {
      let campos = request.resource.data.diff(resource.data).affectedKeys();
      return campos.hasOnly(['rastreabilidadeId', 'updatedAt', 'updatedByEmail', 'naoConformidades', 'assinaturas', 'inspecionadoPor'])
        && (!campos.hasAny(['assinaturas'])
            || request.resource.data.assinaturas.size() > resource.data.get('assinaturas', []).size());
    }

    // Fichas FVS
    match /fvs/{docId} {
      allow read: if request.auth != null;
      allow create: if podeEditar();
      // Travada: só aceita (a) uma NOVA REVISÃO (número da revisão sobe) ou
      // (b) o vínculo com a rastreabilidade. Nada mais muda na ficha assinada.
      allow update: if podeEditar() && (
        !fichaTravada()
        || request.resource.data.get('revisao', 0) > resource.data.get('revisao', 0)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rastreabilidadeId', 'updatedAt', 'updatedByEmail'])
        || baixaOuAssinaturaNaTravada()
      );
      allow delete: if podeEditar() && !fichaTravada();
    }

    // v1.15: cópia de cada FVS antes de uma nova revisão (histórico para
    // auditoria) — só se cria, nunca se altera nem apaga.
    match /fvsRevisoes/{docId} {
      allow read: if request.auth != null;
      allow create: if podeEditar();
      allow update, delete: if false;
    }

    // v1.15: assinatura cadastrada de cada pessoa (o id do documento é o uid
    // do login). Só a própria pessoa grava a sua; ninguém apaga.
    match /assinaturas/{uid} {
      allow read: if request.auth != null;
      allow create, update: if podeEditar() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Controles de rastreabilidade de concreto (FORM-15)
    match /rastreabilidade/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Resultados de ensaio dos corpos de prova (Controle Tecnológico do Concreto)
    match /controleTecnologico/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Biblioteca de plantas de forma
    match /plantas/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Programação e recebimento de aço (v1.5)
    match /entregasAco/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Cronograma da obra: versão atual + histórico de versões enviadas (v1.5)
    match /cronogramas/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // Cópia da última planilha importada, usada como modelo de exportação (v1.8)
    match /planilhasModelo/{docId} {
      allow read: if request.auth != null;
      allow write: if podeEditar();
    }

    // v1.25: tarefas que a engenharia passa para os estagiários
    match /tarefas/{docId} {
      allow read: if request.auth != null;
      allow create, update: if podeEditar();
      allow delete: if false;
    }

    // v1.31: equipe — todos leem; só o administrador inclui/altera; ninguém apaga
    match /equipe/{email} {
      allow read: if request.auth != null;
      allow create, update: if ehAdmin()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.perfil in ['admin', 'engenharia', 'estagiario', 'qualidade'];
      allow delete: if false;
    }

    // v1.30: histórico de alterações — um documento por dia (AAAA-MM-DD) com
    // a lista "entradas", que só cresce. Ninguém altera nem apaga o que já
    // foi registrado.
    match /auditoria/{dia} {
      allow read: if request.auth != null;
      allow create: if podeEditar()
        && request.resource.data.keys().hasOnly(['entradas'])
        && request.resource.data.entradas is list;
      allow update: if podeEditar()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entradas'])
        && request.resource.data.entradas is list
        && request.resource.data.entradas.size() >= resource.data.entradas.size()
        && request.resource.data.entradas.hasAll(resource.data.entradas);
      allow delete: if false;
    }

    // Bloqueia qualquer outra coleção não prevista acima por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
